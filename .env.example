# Copy to .env and fill in what you have. Everything is optional:
# without keys the app uses the free, keyless Pokémon TCG API for metadata and prices.

# https://www.pokewallet.io (free: 1,000 requests/day, no credit card)
POKEWALLET_API_KEY=

# https://tcgapi.dev (free: 100 requests/day, ~7 days of history)
TCGAPI_KEY=

# https://dev.pokemontcg.io (optional, raises rate limits)
POKEMONTCG_API_KEY=
